# --- LAYA CORE (INFERENCE ENGINE) ---
# Dispositivo: cpu oppure cuda (se avessi una GPU)
LAYA_DEVICE=cpu
# Numero di thread CPU da dedicare al modello
LAYA_THREADS=4
# Carica i modelli all'avvio? (1=Sì, 0=No)
LAYA_PRELOAD=1
# Il modello principale da scaricare (basato sui tuoi log)
LAYA_MODEL_ID=convaiinnovations/laya

# --- LAYA MCP BRIDGE ---
# Porta su cui il bridge espone il servizio MCP
LAYA_MCP_PORT=8001
# Indirizzo di ascolto (0.0.0.0 permette l'accesso dalla rete)
LAYA_MCP_LISTEN=0.0.0.0
