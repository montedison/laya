# STAGE 1: Builder
FROM python:3.11-slim AS builder

# Installazione di UV copiandolo dall'immagine ufficiale
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /build

# Installazione dipendenze di sistema
RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# --- CORREZIONE CRUCIALE ---
# Copiamo l'intero contesto del progetto nel builder. 
# Senza la cartella 'laya/' e il 'README.md', l'installazione del pacchetto locale fallisce.
COPY . .

# Installazione dipendenze CPU-only tramite UV
# Ora l'installazione di ".[serve,mcp]" troverà il codice sorgente in /build/laya
RUN uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match \
    torch==2.4.0 ".[serve,mcp]"

# STAGE 2: Runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copia dell'ambiente installato dal builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copia del codice sorgente per l'esecuzione
COPY . /app/

# Configurazione ambiente
ENV PATH="/usr/local/bin:$PATH"
ENV LAYA_DEVICE="cpu"
ENV LAYA_THREADS="4"
ENV LAYA_PRELOAD="1"
ENV HF_HUB_CACHE="/data/huggingface"

# --- SECURITY LAYER ---
RUN useradd -m layauser
RUN mkdir -p /data/huggingface && chown -R layauser:layauser /data/huggingface
