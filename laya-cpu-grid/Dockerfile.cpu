# STAGE 1: Builder
FROM python:3.11-slim AS builder

# Installazione di UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /build

# Installazione dipendenze di sistema
RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Copia dell'intero contesto
COPY . .

# Installazione dipendenze: torch 2.4.0 + laya
RUN uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match \
    torch==2.4.0 ".[serve,mcp]"

# --- TOTAL SURGICAL PATCH (Fix for transformers bug) ---
# Il bug è un NameError causato da Type Hints (torch.Tensor, nn.Module, torch.device)
# in un modulo che viene caricato quando torch è "disabilitato".
# Sostituiamo tutti i riferimenti problematici con tipi Python standard.
RUN sed -i 's/nn.Module/object/g' /usr/local/lib/python3.11/site-packages/transformers/integrations/accelerate.py && \
    sed -i 's/torch.Tensor/object/g' /usr/local/lib/python3.11/site-packages/transformers/integrations/accelerate.py && \
    sed -i 's/torch.device/str/g' /usr/local/lib/python3.11/site-packages/transformers/integrations/accelerate.py

# STAGE 2: Runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copia dell'ambiente installato e PATCHATO dal builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY . /app/

# Configurazione ambiente
ENV PATH="/usr/local/bin:$PATH"
ENV LAYA_DEVICE="cpu"
ENV LAYA_THREADS="4"
ENV LAYA_PRELOAD="1"
ENV HF_HUB_CACHE="/data/huggingface"

# --- SECURITY LAYER ---
RUN useradd -m layauser
RUN mkdir -p /data/huggingface && chown -R layauser:layauser /data/huggingface
