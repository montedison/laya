# STAGE 1: Builder
FROM python:3.11-slim AS builder

# Installazione di UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /build

# Installazione dipendenze di sistema
RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Copia dell'intero contesto
COPY . .

# --- SOLUZIONE DEFINITIVA DEL CONFLITTO ---
# 1. Usiamo torch aggiornato e vediamo come va per soddisfare i requisiti di transformers
# 2. Installiamo laya che porterà le versioni corrette di transformers
RUN uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match \
    torch \
    ".[serve,mcp]"

# STAGE 2: Runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copia dell'ambiente installato dal builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY . /app/

# Configurazione ambiente
ENV PATH="/usr/local/bin:$PATH"
ENV LAYA_DEVICE="cpu"
ENV LAYA_THREADS="4"
ENV LAYA_PRELOAD="1"
ENV HF_HUB_CACHE="/data/huggingface"

# --- SECURITY LAYER ---
RUN useradd -m layauser
RUN mkdir -p /data/huggingface && chown -R layauser:layauser /data/huggingface
