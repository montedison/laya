# STAGE 1: Builder
FROM ghcr.io/astral-sh/uv:latest AS builder

WORKDIR /build

# Installazione dipendenze di sistema
RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Copia dei file di progetto
COPY pyproject.toml uv.lock ./

# Installazione dipendenze CPU-only
RUN uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match \
    torch==2.4.0 ".[serve,mcp]"

# STAGE 2: Runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copia dell'ambiente dal builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copia del codice
COPY . /app/

# Configurazione ambiente
ENV PATH="/usr/local/bin:$PATH"
ENV LAYA_DEVICE="cpu"
ENV LAYA_THREADS="4"
ENV HF_HUB_CACHE="/data/huggingface"

# --- SECURITY LAYER ---
# Creazione utente non-privilegiato
RUN useradd -m layauser

# Preparazione directory cache (per prevenire errori di mkdir)
RUN mkdir -p /data/huggingface && chown -R layauser:layauser /data/huggingface

# L'utente di default rimane root per permettere il pattern di de-escalation nel compose
