# STAGE 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

# Installazione dipendenze di sistema
RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Installazione di uv per velocità estrema
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copia dei file di progetto dalla ROOT (grazie al context: ..)
COPY pyproject.toml uv.lock ./

# Installazione dipendenze CPU-only
RUN uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match \
    torch==2.4.0 ".[serve,mcp]"

# STAGE 2: Runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copia dell'ambiente virtuale dal builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copia di TUTTO il contenuto della ROOT (codice, config, ecc.)
COPY . /app/

# Configurazione ambiente ottimizzata per CPU
ENV PATH="/app/.venv/bin:$PATH"
ENV LAYA_DEVICE="cpu"
ENV LAYA_THREADS="4"
ENV HF_HUB_CACHE="/data/huggingface"

# Creazione utente non-root
RUN useradd -m layauser
USER layauser

VOLUME ["/data/huggingface"]

ENTRYPOINT ["laya-serve"]
